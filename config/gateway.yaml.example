# Valhuntir Gateway configuration
# Copy to gateway.yaml and customize for your environment.
# Environment variables can be referenced as ${VAR_NAME}.

gateway:
  host: "127.0.0.1"
  port: 4508
  log_level: "INFO"

# --- sift-mcp enforcement layers (PRD §7) ---
# These two sections are translated by the gateway into SIFT_* environment
# variables on the sift-mcp backend when it is spawned (see
# sift_gateway.config.apply_security_layers). You do NOT need to export any
# env vars by hand — edit the values here and restart the gateway.

# Layer 1 — OPA policy engine. Compiles security.yaml → Rego and evaluates
# every run_command through OPA. security.py enforcement always runs too
# (belt-and-suspenders), so enabling this is low-risk. ON by default.
policy_engine:
  enabled: true
  # Path to the opa binary. Leave blank to resolve from PATH, then ./tools/opa.
  opa_path: "${SIFT_OPA_PATH}"
  # Path to a security.yaml to compile. Leave blank for the catalog default.
  security_yaml: "${SIFT_SECURITY_YAML}"

# Layer 2 — bubblewrap kernel sandbox. Every tool runs inside a bwrap
# namespace with evidence read-only and the network isolated. Requires
# bubblewrap installed AND (on Ubuntu 24.04) the unprivileged-userns AppArmor
# profile for bwrap — see README "Sandbox prerequisites". Enabling it without
# those in place makes EVERY run_command fail, so it ships commented out.
# Uncomment once bwrap + the userns fix are confirmed on this host:
# sandbox:
#   enabled: true
#   profile: "default"            # profile name under sift_mcp/sandbox/profiles/
#   bwrap_path: "${SIFT_BWRAP_PATH}"  # blank → "bwrap" on PATH

# API key authentication
# Each key maps to an examiner identity and role.
# If this section is empty or missing, auth is disabled (single-user mode).
api_keys:
  vhir_gw_abc123:
    examiner: "steve"
    role: "lead"
  vhir_gw_def456:
    examiner: "jane"
    role: "examiner"

# Backend MCP servers
# type: stdio — launches a subprocess, communicates via MCP stdio transport
# type: http  — connects to a remote MCP server via Streamable HTTP

backends:
  # --- Local subprocess backends (stdio) ---

  forensic-mcp:
    type: stdio
    command: "python"
    args: ["-m", "forensic_mcp", "--deferred-tools"]
    env:
      VHIR_CASE_DIR: "${VHIR_CASE_DIR}"
      VHIR_ACTIVE_CASE: "${VHIR_ACTIVE_CASE}"
      VHIR_EXAMINER: "${VHIR_EXAMINER}"
    enabled: true

  sift-mcp:
    type: stdio
    command: "python"
    args: ["-m", "sift_mcp"]
    env:
      VHIR_CASE_DIR: "${VHIR_CASE_DIR}"
      VHIR_ACTIVE_CASE: "${VHIR_ACTIVE_CASE}"
      VHIR_EXAMINER: "${VHIR_EXAMINER}"
    enabled: true

  case-mcp:
    type: stdio
    command: "python"
    args: ["-m", "case_mcp"]
    env:
      VHIR_CASE_DIR: "${VHIR_CASE_DIR}"
      VHIR_CASES_DIR: "${VHIR_CASES_DIR}"
      VHIR_EXAMINER: "${VHIR_EXAMINER}"
    enabled: true

  report-mcp:
    type: stdio
    command: "python"
    args: ["-m", "report_mcp"]
    env:
      VHIR_CASE_DIR: "${VHIR_CASE_DIR}"
      VHIR_CASES_DIR: "${VHIR_CASES_DIR}"
      VHIR_EXAMINER: "${VHIR_EXAMINER}"
    enabled: true

  forensic-rag-mcp:
    type: stdio
    command: "python"
    args: ["-m", "rag_mcp"]
    env:
      VHIR_CASE_DIR: "${VHIR_CASE_DIR}"
      VHIR_EXAMINER: "${VHIR_EXAMINER}"
    enabled: true

  windows-triage-mcp:
    type: stdio
    command: "python"
    args: ["-m", "windows_triage"]
    env:
      VHIR_CASE_DIR: "${VHIR_CASE_DIR}"
      VHIR_EXAMINER: "${VHIR_EXAMINER}"
    enabled: true

  opencti-mcp:
    type: stdio
    command: "python"
    args: ["-m", "opencti_mcp"]
    env:
      VHIR_CASE_DIR: "${VHIR_CASE_DIR}"
      VHIR_EXAMINER: "${VHIR_EXAMINER}"
      OPENCTI_URL: "${OPENCTI_URL}"
      OPENCTI_TOKEN: "${OPENCTI_TOKEN}"
    enabled: true

  # --- Remote HTTP backends ---

  # Windows forensic workstation running wintools-mcp
  wintools-mcp:
    type: http
    url: "http://windows-workstation:4624/mcp"
    bearer_token: "${WINTOOLS_TOKEN}"
    enabled: false

  remnux-mcp:
    type: http
    url: "https://remnux.example.com/mcp"
    bearer_token: "${REMNUX_TOKEN}"
    enabled: false

  microsoft-learn:
    type: http
    url: "https://learn.example.com/mcp"
    enabled: false

  zeltser-ir-writing:
    type: http
    url: "https://zeltser.example.com/mcp"
    enabled: false
